# MongoDB Connection Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=midterm_data_pipeline0
RAW_COLLECTION=orders_raw
VALIDATED_COLLECTION=orders_validated
QUARANTINE_COLLECTION=orders_quarantine

# High-Concurrency MongoDB Settings
MONGODB_MAX_POOL_SIZE=200
MONGODB_SOCKET_TIMEOUT_MS=600000

# Pipeline Routing Configuration (Threshold in MB)
SMALL_FILE_THRESHOLD_MB=200.0

# Batch Processing Sizes
BATCH_SIZE=5000
SPARK_BATCH_SIZE=10000

# Apache Spark Cluster/Local Configuration
SPARK_APP_NAME=Midterm-Data-Pipeline-PySpark
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=5g
SPARK_SHUFFLE_PARTITIONS=16

# FastAPI Server Settings
API_HOST=127.0.0.1
API_PORT=8000
